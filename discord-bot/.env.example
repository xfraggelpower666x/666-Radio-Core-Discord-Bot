# ============================================================
# 666RadioCoreDJ - ENV Vorlage
# Erstellt: 2026-06-03
# Geändert: 2026-06-03
# Version: v1.3.0
# Wichtig: Diese Datei kopieren nach .env und echte Werte dort eintragen.
# Niemals echte Secrets in GitHub committen.
# ============================================================

# Discord Bot
DISCORD_TOKEN=PASTE_DISCORD_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=PASTE_DISCORD_APPLICATION_CLIENT_ID_HERE
DISCORD_GUILD_ID=PASTE_DISCORD_SERVER_GUILD_ID_HERE
RADIO_TEXT_CHANNEL_ID=PASTE_ALLOWED_TEXT_CHANNEL_ID_HERE
RADIO_LOG_CHANNEL_ID=PASTE_OPTIONAL_LOG_CHANNEL_ID_HERE
ALLOWED_ROLE_IDS=ROLE_ID_1,ROLE_ID_2

# Bot Branding / Verhalten
BOT_ACTIVITY=666RadioCoreDJ
BOT_PREFIX=!radio
CONTROL_PANEL_TITLE=666RadioCoreDJ Control
SKIP_COOLDOWN_SECONDS=60
JINGLE_COOLDOWN_SECONDS=20
VOICE_RECONNECT_SECONDS=10

# SonicPanel / MyIDJ - Service Account
# Keine echten Login-Daten in diese Vorlage schreiben.
# Deine echten DJ-Daten gehören nur in .env auf dem Zielsystem.
# Hinweis: SonicPanel-DJ-Panel ggf. mit HTTP auf Port 2080 testen, falls HTTPS nicht funktioniert.
SONICPANEL_PANEL_URL=http://YOUR_PANEL_HOST:2080
SONICPANEL_DJ_USER=PASTE_DJ_USER_HERE
SONICPANEL_DJ_PASS=PASTE_DJ_PASSWORD_HERE

# Primary Adapter: direct_sonicpanel oder disabled
# direct_sonicpanel nutzt konfigurierte URLs. Wenn SonicPanel-Button-Request noch unbekannt ist, leer lassen.
RADIO_SKIP_PRIMARY=direct_sonicpanel

# Wird eingetragen, nachdem der echte Skip-Request im Browser-Netzwerk-Tab gefunden wurde.
# Beispiele nur Platzhalter - keine echten Secrets in diese Vorlage schreiben.
SONICPANEL_SKIP_URL=
SONICPANEL_SKIP_METHOD=POST
SONICPANEL_SKIP_AUTH=none
# Optionen: none | basic | bearer
SONICPANEL_SKIP_BEARER_TOKEN=

# Jingle/ID Direktsteuerung - Template mit {name} oder {id}, sobald der echte Request bekannt ist.
SONICPANEL_JINGLE_URL_TEMPLATE=
SONICPANEL_JINGLE_METHOD=POST
SONICPANEL_JINGLE_AUTH=none
SONICPANEL_JINGLE_BEARER_TOKEN=

# Optionaler Fallback: SHOUTcast Source-Kick. Nur aktivieren, wenn bewusst gewollt.
RADIO_SKIP_FALLBACK=disabled
SHOUTCAST_ADMIN_CGI_URL=http://YOUR_STREAM_HOST:PORT/admin.cgi
SHOUTCAST_SID=1
SHOUTCAST_ADMIN_USER=admin
SHOUTCAST_ADMIN_PASS=PASTE_SHOUTCAST_ADMIN_PASSWORD_HERE
SHOUTCAST_PASS_QUERY_ENABLED=false

# Discord-Voice-Stream
# /play nutzt den Default-Preset. /play preset:1-5 kann direkt umschalten.
# Falls keine Presets gesetzt sind, wird RADIO_STREAM_URL als Fallback verwendet.
VOICE_RELAY_ENABLED=false
VOICE_CHANNEL_ID=PASTE_VOICE_CHANNEL_ID_HERE
RADIO_STREAM_URL=http://YOUR_STREAM_HOST:PORT/stream
RADIO_STREAM_BITRATE=128000
STREAM_HEALTH_INTERVAL_SECONDS=30
STREAM_HEALTH_TIMEOUT_SECONDS=10

# Stream-Preset-System: bis zu 5 Streams
VOICE_DEFAULT_PRESET=1
VOICE_DEFAULT_VOLUME_PERCENT=80
VOICE_MAX_VOLUME_PERCENT=200

STREAM_PRESET_1_NAME=Main Radio
STREAM_PRESET_1_URL=http://YOUR_STREAM_HOST:PORT/stream
STREAM_PRESET_1_VOLUME_PERCENT=80

STREAM_PRESET_2_NAME=Backup Stream
STREAM_PRESET_2_URL=
STREAM_PRESET_2_VOLUME_PERCENT=80

STREAM_PRESET_3_NAME=AutoDJ Stream
STREAM_PRESET_3_URL=
STREAM_PRESET_3_VOLUME_PERCENT=80

STREAM_PRESET_4_NAME=Live DJ Stream
STREAM_PRESET_4_URL=
STREAM_PRESET_4_VOLUME_PERCENT=80

STREAM_PRESET_5_NAME=Test Stream
STREAM_PRESET_5_URL=
STREAM_PRESET_5_VOLUME_PERCENT=80

# Logging
LOG_LEVEL=info
