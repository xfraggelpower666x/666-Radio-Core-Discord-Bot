# Discord bot identity
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Required radio stream
RADIO_STREAM_URL=
RADIO_STREAM_TITLE=666SOUNDsDESIGn WebRadio Stream
RADIO_DEFAULT_VOLUME=80

# Optional Discord defaults. Leave 0 to configure with /radio commands.
RADIO_VOICE_CHANNEL_ID=0
RADIO_LOG_TEXT_CHANNEL_ID=0
RADIO_ADMIN_ROLE_ID=0
RADIO_ALLOWED_ROLE_IDS=

# Docker compose service defaults
MONGODB_URL=mongodb://mongo:27017
MONGODB_NAME=radio_bot_ai
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
SOUNDCLOUD_SEARCH_ENABLED=true

# PHASE2C Worker bridge for /radioaddon commands
RADIOBOTAI_WORKER_URL=https://666radiobotai.666soundsdesign-broadcaster.com
RADIOBOTAI_ADMIN_TOKEN=

# Keep startup deterministic
RADIO_DISABLE_UPDATE_CHECK=true
RADIO_SYNC_COMMANDS_ON_START=true
