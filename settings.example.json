"""666 RadioBotAI version helper.

Der alte Vocard-Updater wurde absichtlich deaktiviert, damit dieser umgebaute
RadioBotAI-Build nicht versehentlich durch ein upstream Vocard-Update
überschrieben wird.
"""

__version__ = "v666-radiobotai-1.0.0"


def check_version(with_msg: bool = False) -> str:
    if with_msg:
        print(f"666 RadioBotAI Version: {__version__}")
    return __version__


if __name__ == "__main__":
    check_version(with_msg=True)
