# Discord application credentials
DISCORD_TOKEN=Nachzutragen_Discord_Bot_Token
CLIENT_ID=Nachzutragen_Discord_Application_Client_ID

# Optional: faster command updates while testing. Leave empty for global commands.
GUILD_ID=Nachzutragen_Test_Server_ID

# Optional: channel for bot/radio events.
LOG_CHANNEL_ID=Nachzutragen_Text_Channel_ID

# Default radio stream. Can be overridden with /radio play stream_url:<url>.
RADIO_STREAM_URL=https://example.com/live
RADIO_STATION_NAME=666SOUNDsDESIGn Radio Core

# Stream supervision
STREAM_HEALTH_INTERVAL_MS=30000
STREAM_HEALTH_TIMEOUT_MS=10000
AUTO_RECONNECT=true
MAX_RECONNECT_ATTEMPTS=0
